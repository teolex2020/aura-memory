{"id": "s01", "lang": "en", "need": "reason", "records": [{"text": "The C++ build of the Harbor renderer took 40 minutes on CI.", "level": "domain", "tags": ["harbor", "build", "ci"], "semantic_type": "fact", "source": "user", "caused_by": null, "content_type": "text"}, {"text": "We switched the Harbor renderer build to Zig.", "level": "decisions", "tags": ["harbor", "build", "zig"], "semantic_type": "decision", "source": "user", "caused_by": 0, "content_type": "text"}, {"text": "The Harbor docs site moved from Jekyll to Hugo.", "level": "decisions", "tags": ["harbor", "docs"], "semantic_type": "decision", "source": "user", "caused_by": null, "content_type": "text"}, {"text": "Jekyll builds for the Harbor docs take about 2 minutes.", "level": "domain", "tags": ["harbor", "docs", "build"], "semantic_type": "fact", "source": "user", "caused_by": null, "content_type": "text"}, {"text": "Current task: port the shader loader to the new build setup.", "level": "working", "tags": ["harbor", "shaders"], "semantic_type": "fact", "source": "user", "caused_by": null, "content_type": "text"}, {"text": "Harbor CI runners are 8-core machines.", "level": "domain", "tags": ["harbor", "ci"], "semantic_type": "fact", "source": "user", "caused_by": null, "content_type": "text"}], "question": "Why did we switch the Harbor renderer build to Zig?", "expected_any": ["40 min", "forty min"]}
